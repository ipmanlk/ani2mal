{
  "tasks": {
    "run": "deno run --allow-net=graphql.anilist.co,api.myanimelist.net,myanimelist.net --allow-env --allow-read --allow-write --allow-run=xdg-open src/cli/index.ts",
    "run:insecure": "deno run -A src/cli/index.ts",
    "check": "deno check src/cli/index.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "test": "deno test --allow-env --allow-read --allow-write --allow-sys",
    "test:coverage": "deno test --allow-env --allow-read --allow-write --allow-sys --coverage && deno coverage --lcov --output=coverage/lcov.info --exclude=tests/ && deno run --allow-read scripts/check-coverage.ts",
    "compile": "mkdir -p dist && deno compile --allow-net=graphql.anilist.co,api.myanimelist.net,myanimelist.net --allow-env --allow-read --allow-write --allow-run=xdg-open --output dist/ani2mal src/cli/index.ts"
  },
  "imports": {
    "@/": "./src/",
    "@std/expect": "jsr:@std/expect@^1",
    "valibot": "jsr:@valibot/valibot@^1.4.2",
    "fast-xml-parser": "npm:fast-xml-parser@^5.2.5"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true,
    "semiColons": false,
    "exclude": ["**/*.md", "todo", "dist", "coverage", ".tmp"]
  },
  "lint": {
    "exclude": ["todo", "dist", "coverage", ".tmp"]
  },
  "test": {
    "include": ["tests/**/*.test.ts"]
  },
  // Aggregate line coverage is enforced per-directory in
  // scripts/check-coverage.ts because native thresholds cannot scope to
  // src/** while skipping the CLI glue layer.
  "exclude": ["dist", "coverage", ".tmp", "node_modules"]
}
